{
  "name": "dsh-plugin-web-notify",
  "version": "0.3.0",
  "description": "Browser notifications for DeepSeek Harness: agent updates, turn completion, approvals, plan reviews, and questions.",
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "files": [
    "client.js",
    "client/*.ts",
    "index.ts",
    "lib/*.ts",
    "scripts/build-client.mjs",
    "README.md",
    "design.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "pnpm build:client",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm check:client && pnpm test && pnpm typecheck"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification"
  ]
}
